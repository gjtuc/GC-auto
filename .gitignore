# Secrets — never commit
.env
.env.*
!.env.example
gc_automation.env
**/gc_automation.env
machine_profile.json
**/machine_profile.json
!deploy/machine_profile.template*.json
!deploy/machine_profile.reference*.json

# Runtime state (장비 PC Desktop\KCH mirrors 등)
.gc_send_state.json
.gc_watch_status.json
GC_감시_상태.txt
GC_중지_*.txt
MMDDHHmm.txt
MMDDHHmm_screener.txt

# 차헌: script_dir = repo data_pc\ (로컬 데이터·비밀은 Git 제외)
data_pc/KCH/inbox/*
!data_pc/KCH/inbox/.gitkeep
data_pc/KCH/processed/*
!data_pc/KCH/processed/.gitkeep
data_pc/KCH/.data_pc_*
data_pc/KCH/**/*.tmp
data_pc/gc_automation.env

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor
Thumbs.db
Desktop.ini
.idea/

# Cursor auto-sync log (hook)
.cursor/hooks/auto_git_sync.log
.cursor/hooks/session_start_git.log
.cursor/hooks/agent_queue_stop.log
.cursor/hooks/task_queue_continue.log
.cursor/hooks/quit_cursor.log
.cursor/hooks/_*.json
