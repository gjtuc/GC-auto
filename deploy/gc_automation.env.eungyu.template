# =============================================================================
# 은규 PC — gc_automation.env 템플릿
# =============================================================================
# [LLM] 복사 위치: %USERPROFILE%\gc-data-pc\gc_automation.env (Git commit 금지)
#       port_eungyu_data_pc.ps1 이 파일이 없을 때 자동 생성함.
#
# 은규 PC 정책 (차헌 PC와 다름):
#   · 실험 저장 = 로컬 연구노트 (G: / SecuYouSB 없음)
#   · 인터넷 = 이더넷 상시 연결
#   · supervisor 게이트 = 없음 (Wi‑Fi 끔, G: 끔) → 15초 IMAP 폴링만
#   · machine_profile.json 에 "uses_g_drive": false 필수
#
# 상세: docs/은규PC_이식_가이드.md
# =============================================================================

NAVER_EMAIL=은규_네이버메일@naver.com
NAVER_APP_PASSWORD=16자리_앱비밀번호
MAIL_TO=은규_네이버메일@naver.com

# --- supervisor / watch (은규 PC: 게이트 없음) ---
# Wi‑Fi 핫스팟 검사 끔 — 데이터 PC는 이더넷 사용 (차헌 PC와 동일 정책)
DATA_PC_SKIP_WIFI_CHECK=1
# G: 게이트는 env가 아니라 machine_profile uses_g_drive:false 로 끔
# DATA_PC_SKIP_GDRIVE_GATE=1

# 15초마다 메일 확인
DATA_PC_WATCH_INTERVAL_SEC=15
# 성공 후 쿨다운 (분)
DATA_PC_AUTO_MAIL_COOLDOWN_MINUTES=10
# 부팅 직후 미처리 메일 1회
DATA_PC_BOOT_MAIL_CHECK=1

# Origin 4단계 (0=켜기, 1=끄기)
DATA_PC_SKIP_ORIGIN=0
# 엑셀 배치 후 시료별 Origin 1회 (기본)
# DATA_PC_ORIGIN_PER_MAIL=1

# G: 재시도 — uses_g_drive:false PC에서는 거의 사용 안 함 (호환용)
DATA_PC_GDRIVE_RETRY_SEC=180
